# Copy this file to .env (same folder) and fill in the values. .env is git-ignored: it never goes to
# GitHub and never goes in the app. Never paste these values into chat. See docs/BATCH7-SETUP.md.

# Supabase dashboard -> Project Settings -> Data API (Project URL)
SUPABASE_URL=

# Supabase dashboard -> Project Settings -> API Keys. The publishable key is safe in the app;
# the secret key is not, so it lives only here.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The test user you create in Authentication -> Users (for npm run test-score-response).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# The app's copies of the URL and publishable key (both safe in the app; Expo puts EXPO_PUBLIC_
# values into the app bundle). Same values as SUPABASE_URL (just https://<ref>.supabase.co) and
# SUPABASE_PUBLISHABLE_KEY above. Never put the secret key in an EXPO_PUBLIC_ line.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
